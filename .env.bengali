# ==============================================================================
# BENGALI TRAINING CONFIGURATION
# ==============================================================================
# Configuration for training Bengali language models with the bengali_chat_conv dataset

# ==============================================================================
# MODEL CONFIGURATION
# ==============================================================================

# Model optimized for Bengali text
# Options: unsloth/gemma-2-9b-it-bnb-4bit, unsloth/gemma-2-27b-bnb-4bit
MODEL_NAME=unsloth/gemma-2-9b-it-bnb-4bit

# Maximum sequence length (Bengali text can be longer)
MAX_SEQ_LENGTH=2048

# Use 4-bit quantization for memory efficiency
LOAD_IN_4BIT=true

# Data type for model computations
DTYPE=auto

# ==============================================================================
# BENGALI DATASET CONFIGURATION
# ==============================================================================

# Bengali dataset from Hugging Face
DATASET_SOURCE=huggingface
DATASET_NAME=spedrox-sac/bengali_chat_conv
DATASET_SPLIT=train

# Local data path (for processed data)
DATA_PATH=bengali_training_data.json

# Text field name in the dataset
DATASET_TEXT_FIELD=text

# Maximum examples to process (0 = all)
MAX_EXAMPLES=0

# ==============================================================================
# TRAINING PARAMETERS - OPTIMIZED FOR BENGALI
# ==============================================================================

# Batch size (start small for Bengali text)
PER_DEVICE_TRAIN_BATCH_SIZE=1

# Gradient accumulation for effective larger batch size
GRADIENT_ACCUMULATION_STEPS=8

# Training steps (adjust based on dataset size)
MAX_STEPS=500

# Learning rate (slightly lower for Bengali)
LEARNING_RATE=1e-4

# Warmup steps
WARMUP_STEPS=50

# ==============================================================================
# LORA CONFIGURATION - FOR MULTILINGUAL MODELS
# ==============================================================================

# LoRA rank (higher for multilingual adaptation)
LORA_R=32

# LoRA alpha
LORA_ALPHA=32

# LoRA dropout
LORA_DROPOUT=0.1

# Target modules for Bengali language modeling
LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj

# Bias parameter
LORA_BIAS=none

# Use gradient checkpointing
USE_GRADIENT_CHECKPOINTING=unsloth

# Random state for reproducibility
RANDOM_STATE=3407

# ==============================================================================
# SYSTEM OPTIMIZATION FOR BENGALI
# ==============================================================================

# Memory optimization
MEMORY_OPTIMIZATION=high

# Mixed precision training
USE_MIXED_PRECISION=true

# Sequence packing (can help with varied Bengali text lengths)
PACKING=false

# Data validation
DATA_VALIDATION=lenient

# ==============================================================================
# OUTPUT CONFIGURATION
# ==============================================================================

# Output directory
OUTPUT_DIR=./outputs/bengali-model

# Model name
NEW_MODEL_NAME=bengali-chat-gemma-2-9b

# Save method
SAVE_METHOD=merged_16bit

# Whether to save the model
SAVE_MODEL=true

# ==============================================================================
# HUGGING FACE CONFIGURATION
# ==============================================================================

# Push to Hugging Face Hub
PUSH_TO_HUB=false

# Your Hugging Face token (required if PUSH_TO_HUB=true)
# HF_TOKEN=your_token_here

# Your Hugging Face username
# HF_USERNAME=your_username

# Repository name
# HF_REPO_NAME=bengali-chat-model

# ==============================================================================
# EVALUATION CONFIGURATION
# ==============================================================================

# Run evaluation after training
RUN_EVALUATION=true

# Evaluation batch size
EVAL_BATCH_SIZE=1

# Number of samples to evaluate
EVAL_SAMPLES=10

# Generation parameters for Bengali
EVAL_TEMPERATURE=0.7
EVAL_MAX_NEW_TOKENS=512

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================

# Logging level
LOG_LEVEL=INFO

# Verbose logging for debugging Bengali processing
VERBOSE_LOGGING=true

# Log file
LOG_FILE=logs/bengali_training.log

# Logging steps
LOGGING_STEPS=10

# ==============================================================================
# ADVANCED CONFIGURATION
# ==============================================================================

# Dataset preprocessing
DATASET_SHUFFLE=true
DATASET_SEED=42

# Validation split
VALIDATION_SPLIT=0.1

# Early stopping (disable for full training)
EARLY_STOPPING_PATIENCE=0

# DataLoader configuration
DATALOADER_NUM_WORKERS=1
DATALOADER_PIN_MEMORY=true

# Cache directory
CACHE_DIR=./cache/bengali

# ==============================================================================
# BENGALI-SPECIFIC SETTINGS
# ==============================================================================

# Tokenizer settings for Bengali
TOKENIZER_PADDING=true
TOKENIZER_TRUNCATION=true
TOKENIZER_MAX_LENGTH=2048

# Bengali text processing
PRESERVE_BENGALI_NUMERALS=true
NORMALIZE_BENGALI_TEXT=false

# Chat template for Bengali conversations
USE_BENGALI_CHAT_TEMPLATE=true
