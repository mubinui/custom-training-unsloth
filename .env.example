# ==============================================================================
# UNSLOTH CUSTOM TRAINING CONFIGURATION
# ==============================================================================
# Copy this file to .env and modify the values according to your needs
# This file should be kept private and not committed to version control

# ==============================================================================
# MODEL CONFIGURATION
# ==============================================================================

# Model to use for fine-tuning
# Available options: unsloth/gemma-2-9b-it-bnb-4bit, unsloth/gemma-3-4B-it, 
# unsloth/Meta-Llama-3.1-8B-bnb-4bit, unsloth/mistral-7b-instruct-v0.3-bnb-4bit
MODEL_NAME=unsloth/gemma-2-9b-it-bnb-4bit

# Maximum sequence length for input text
MAX_SEQ_LENGTH=2048

# Whether to load model in 4-bit quantization
LOAD_IN_4BIT=true

# Data type for model computations (auto, float16, bfloat16)
DTYPE=auto

# ==============================================================================
# LORA CONFIGURATION
# ==============================================================================

# LoRA rank (lower = less parameters, faster training)
LORA_R=16

# LoRA alpha (scaling factor, typically same as rank)
LORA_ALPHA=16

# LoRA dropout (0.0 = no dropout, optimized for Unsloth)
LORA_DROPOUT=0.0

# Which layers to apply LoRA to (comma-separated)
# Default: q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj
LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj

# Bias parameter for LoRA (none, all, lora_only)
LORA_BIAS=none

# Whether to use gradient checkpointing (true, false, unsloth)
USE_GRADIENT_CHECKPOINTING=unsloth

# Random state for reproducibility
RANDOM_STATE=3407

# Whether to use rank-stabilized LoRA
USE_RSLORA=false

# ==============================================================================
# TRAINING PARAMETERS
# ==============================================================================

# Batch size per device (reduce if you have memory issues)
PER_DEVICE_TRAIN_BATCH_SIZE=2

# Gradient accumulation steps (effective batch size = batch_size * accumulation_steps)
GRADIENT_ACCUMULATION_STEPS=4

# Number of warmup steps
WARMUP_STEPS=5

# Maximum number of training steps
MAX_STEPS=60

# Learning rate
LEARNING_RATE=2e-4

# Whether to use FP16 precision (auto, true, false)
FP16=auto

# Whether to use BF16 precision (auto, true, false)
BF16=auto

# How often to log training metrics
LOGGING_STEPS=1

# Optimizer to use
OPTIM=adamw_8bit

# Weight decay for regularization
WEIGHT_DECAY=0.01

# Learning rate scheduler type
LR_SCHEDULER_TYPE=linear

# Training seed
SEED=3407

# ==============================================================================
# DATA CONFIGURATION
# ==============================================================================

# Path to training data file
DATA_PATH=sample_data.json

# Text field name in the dataset
DATASET_TEXT_FIELD=text

# Whether to pack sequences for efficiency
PACKING=false

# Data validation mode (strict, lenient, none)
DATA_VALIDATION=strict

# ==============================================================================
# OUTPUT AND SAVING
# ==============================================================================

# Directory to save outputs
OUTPUT_DIR=./outputs

# Whether to save the final model
SAVE_MODEL=true

# Save method (merged_16bit, lora_only, gguf)
SAVE_METHOD=merged_16bit

# Name for the new model
NEW_MODEL_NAME=gemma-2-9b-custom-finetune

# ==============================================================================
# HUGGING FACE INTEGRATION
# ==============================================================================

# Whether to push model to Hugging Face Hub
PUSH_TO_HUB=false

# Hugging Face token (required if PUSH_TO_HUB=true)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=

# Hugging Face username/organization
HF_USERNAME=

# Repository name on Hugging Face
HF_REPO_NAME=

# ==============================================================================
# SYSTEM CONFIGURATION
# ==============================================================================

# Number of CPU workers for data processing
NUM_WORKERS=4

# CUDA device to use (-1 for auto, 0,1,2... for specific GPU)
CUDA_DEVICE=-1

# Memory optimization level (low, medium, high)
MEMORY_OPTIMIZATION=medium

# Whether to use mixed precision training
USE_MIXED_PRECISION=true

# Cache directory for models and datasets
CACHE_DIR=./cache

# ==============================================================================
# LOGGING AND MONITORING
# ==============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Whether to enable detailed logging
VERBOSE_LOGGING=false

# Log file path (empty for console only)
LOG_FILE=

# Whether to log training metrics to wandb
USE_WANDB=false

# Wandb project name
WANDB_PROJECT=unsloth-custom-training

# Wandb entity (username/team)
WANDB_ENTITY=

# ==============================================================================
# EVALUATION CONFIGURATION
# ==============================================================================

# Whether to run evaluation after training
RUN_EVALUATION=true

# Evaluation batch size
EVAL_BATCH_SIZE=1

# Number of samples to evaluate (0 = all)
EVAL_SAMPLES=10

# Temperature for generation during evaluation
EVAL_TEMPERATURE=0.7

# Maximum tokens to generate during evaluation
EVAL_MAX_NEW_TOKENS=256

# ==============================================================================
# ADVANCED CONFIGURATION
# ==============================================================================

# Dataset preprocessing options
DATASET_SHUFFLE=true
DATASET_SEED=42

# Training resumption
RESUME_FROM_CHECKPOINT=

# Early stopping patience (0 = disabled)
EARLY_STOPPING_PATIENCE=0

# Validation split ratio (0.0 to 1.0)
VALIDATION_SPLIT=0.1

# Whether to use deepspeed
USE_DEEPSPEED=false

# Whether to use DataLoader workers
DATALOADER_NUM_WORKERS=0

# Pin memory for DataLoader
DATALOADER_PIN_MEMORY=true
